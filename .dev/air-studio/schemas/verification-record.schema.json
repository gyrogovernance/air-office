{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.studio.invalid/architecture/verification-record.schema.json",
  "title": "Studio execution evidence",
  "description": "Schema validity is not evidence validity. The CLI must check fingerprints, artifacts, target compatibility, and actual runner output.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "check_id", "status", "target", "source", "inputs", "tool_versions", "started_at", "finished_at", "exit_code", "selected_test_count", "scenario_ids", "artifacts", "reason"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "check_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "status": { "enum": ["pass", "fail", "skip", "blocked", "not-run"] },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["os", "architecture", "os_version"],
      "properties": {
        "os": { "enum": ["windows", "macos", "linux", "unspecified"] },
        "architecture": { "enum": ["x64", "arm64", "unspecified"] },
        "os_version": { "type": ["string", "null"] }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "tree_sha256"],
      "properties": {
        "commit": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40,64}$" },
        "tree_sha256": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "kind"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "sha256": { "$ref": "#/$defs/hash" },
          "kind": { "enum": ["lockfile", "fixture", "configuration", "resource", "source"] }
        }
      }
    },
    "tool_versions": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "started_at": { "type": ["string", "null"], "format": "date-time" },
    "finished_at": { "type": ["string", "null"], "format": "date-time" },
    "exit_code": { "type": ["integer", "null"] },
    "selected_test_count": { "type": ["integer", "null"], "minimum": 0 },
    "scenario_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[AT]-[0-9]{3}$" } },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "kind"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "sha256": { "$ref": "#/$defs/hash" },
          "kind": { "enum": ["test-report", "log", "installer", "signature-report", "performance-report", "sbom"] }
        }
      }
    },
    "reason": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["pass", "fail"] } }, "required": ["status"] },
      "then": {
        "properties": {
          "source": { "properties": { "tree_sha256": { "$ref": "#/$defs/hash" } } },
          "started_at": { "type": "string", "format": "date-time" },
          "finished_at": { "type": "string", "format": "date-time" },
          "exit_code": { "type": "integer" },
          "tool_versions": { "minProperties": 1 },
          "artifacts": { "minItems": 1 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "pass" } }, "required": ["status"] },
      "then": {
        "properties": {
          "exit_code": { "const": 0 },
          "target": {
            "properties": {
              "os": { "enum": ["windows", "macos", "linux"] },
              "architecture": { "enum": ["x64", "arm64"] },
              "os_version": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "fail" } }, "required": ["status"] },
      "then": { "properties": { "exit_code": { "type": "integer", "not": { "const": 0 } }, "reason": { "type": "string", "minLength": 1 } } }
    },
    {
      "if": {
        "properties": { "status": { "const": "pass" }, "scenario_ids": { "minItems": 1 } },
        "required": ["status", "scenario_ids"]
      },
      "then": { "properties": { "selected_test_count": { "type": "integer", "minimum": 1 } } }
    },
    {
      "if": { "properties": { "status": { "enum": ["skip", "blocked", "not-run"] } }, "required": ["status"] },
      "then": { "properties": { "reason": { "type": "string", "minLength": 10 } } }
    }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:).+$" }
  }
}
