{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.studio.invalid/architecture/module-manifest.schema.json",
  "title": "Studio module declaration",
  "description": "Architecture declaration, not a claim of successful verification. The .invalid namespace is an offline identifier, not a fetch endpoint.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "purpose", "kind", "lifecycle", "ownership", "entrypoints", "foundation_dependencies", "required_ports", "contracts", "events", "feature_ids", "scenario_ids", "documentation"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/name" },
    "title": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 20 },
    "kind": { "enum": ["capability", "foundation"] },
    "lifecycle": { "enum": ["scaffold", "active", "deprecated"] },
    "ownership": {
      "type": "object", "additionalProperties": false,
      "required": ["entities", "table_prefixes"],
      "properties": {
        "entities": { "$ref": "#/$defs/names" },
        "table_prefixes": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*_$" }
        }
      }
    },
    "entrypoints": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "domain": { "$ref": "#/$defs/sourcePath" },
        "service": { "$ref": "#/$defs/sourcePath" },
        "ui": { "$ref": "#/$defs/sourcePath" }
      },
      "minProperties": 1
    },
    "foundation_dependencies": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["contracts", "ui-kit", "runtime", "test-kit"] }
    },
    "required_ports": { "$ref": "#/$defs/names" },
    "contracts": { "$ref": "#/$defs/names" },
    "events": {
      "type": "object", "additionalProperties": false,
      "required": ["emits", "consumes"],
      "properties": {
        "emits": { "$ref": "#/$defs/names" },
        "consumes": { "$ref": "#/$defs/names" }
      }
    },
    "feature_ids": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^F-[0-9]{3}$" }
    },
    "scenario_ids": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[AT]-[0-9]{3}$" }
    },
    "documentation": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePath" }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "names": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/name" } },
    "relativePath": {
      "type": "string", "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:).+$"
    },
    "sourcePath": {
      "allOf": [
        { "$ref": "#/$defs/relativePath" },
        { "type": "string", "pattern": "^src/[a-z0-9/-]+\\.(?:domain|service|ui)\\.public\\.ts$" }
      ]
    }
  }
}
