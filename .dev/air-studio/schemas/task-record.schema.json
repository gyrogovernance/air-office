{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.studio.invalid/architecture/task-record.schema.json",
  "title": "Studio bounded implementation task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "outcome", "status", "feature_ids", "scenario_ids", "modules", "allowed_paths", "contract_changes", "migration_changes", "acceptance_checks", "blockers", "evidence"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^task-[0-9]{4}-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "outcome": { "type": "string", "minLength": 20 },
    "status": { "enum": ["planned", "in-progress", "blocked", "completed"] },
    "feature_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^F-[0-9]{3}$" }
    },
    "scenario_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[AT]-[0-9]{3}$" }
    },
    "modules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/name" } },
    "allowed_paths": {
      "description": "Reviewable scope hints. This is not a security sandbox or authority to ignore a necessary cross-cutting fix.",
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "contract_changes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "migration_changes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "acceptance_checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "description", "required"],
        "properties": {
          "id": { "$ref": "#/$defs/name" },
          "description": { "type": "string", "minLength": 10 },
          "required": { "type": "boolean" }
        }
      }
    },
    "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "evidence": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
      "then": { "properties": { "blockers": { "maxItems": 0 }, "evidence": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "status": { "const": "blocked" } }, "required": ["status"] },
      "then": { "properties": { "blockers": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:).+$" }
  }
}
