{
  "schema_version": 1,
  "id": "knowledge",
  "title": "Knowledge collections and retrieval",
  "purpose": "Own collection membership, derived embedding indexes, and authorized retrieval results.",
  "kind": "capability",
  "lifecycle": "scaffold",
  "ownership": {
    "entities": ["collection", "chunk", "embedding-index", "retrieval-result"],
    "table_prefixes": ["knowledge_"]
  },
  "entrypoints": {
    "domain": "src/knowledge.domain.public.ts",
    "service": "src/knowledge.service.public.ts",
    "ui": "src/knowledge.ui.public.ts"
  },
  "foundation_dependencies": ["contracts", "ui-kit"],
  "required_ports": ["knowledge-store", "source-access", "embedding-provider", "job-submission", "authorization"],
  "contracts": ["knowledge-retrieve-request", "knowledge-retrieve-response"],
  "events": {
    "emits": ["knowledge-index-updated"],
    "consumes": ["document-source-version-created", "identity-access-revoked"]
  },
  "feature_ids": ["F-006"],
  "scenario_ids": ["A-004", "T-010", "T-011"],
  "documentation": ["README.md"]
}
