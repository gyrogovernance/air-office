{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://air-office.dev/contracts/chat-run.schema.json",
  "title": "Chat run request",
  "description": "The validated input a provider connection consumes to start a single streaming run. It carries the assembled message turns and the inspectable context the user intended to review.",
  "type": "object",
  "required": [
    "runId",
    "model",
    "messages"
  ],
  "additionalProperties": false,
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/turn"
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selection": {
          "type": "string"
        },
        "fileName": {
          "type": "string"
        },
        "fileId": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": [
              "chunkId",
              "sourceVersionId",
              "collectionId",
              "text",
              "score",
              "anchor",
              "resolved"
            ],
            "properties": {
              "chunkId": {
                "type": "string"
              },
              "sourceVersionId": {
                "type": "string"
              },
              "collectionId": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "score": {
                "type": "number"
              },
              "resolved": {
                "type": "boolean"
              },
              "anchor": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "turn": {
      "type": "object",
      "required": [
        "role",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "system",
            "user",
            "assistant"
          ]
        },
        "content": {
          "type": "string",
          "maxLength": 400000
        }
      }
    }
  }
}
